Configs: {
	NMConfig: {
		DisplayName: Neat Mediumcore Config

		ShowButtonsToggle: {
			Label: Show multiplayer button
			Tooltip: Shows button that allows to pick up other players items (Only works in multiplayer)
		}

		ItemsGlowToggle: {
			Label: Dropped items Glow
			Tooltip: Items dropped from player glow
		}

		DarkSoulsModeToggle: {
			Label: Dark Souls mode
			Tooltip: Only items from the latest death persist in the world, all others disappear
		}

		ShowDebugInfoInventoryToggle: {
			Label: Show debug info in inventory
			Tooltip: Shows debug info in item description
		}

		ShowDebugInfoDroppedToggle: {
			Label: Show debug info on dropped items
			Tooltip: Shows debug info on dropped items
		}
	}
}

"Keybinds.Pick up other players items toggle.DisplayName": Pick up other players items toggle
